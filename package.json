{
  "name": "hypixel-guild-highlight-reel",
  "version": "1.0.0",
  "description": "A Discord Bot that creates a highlight reel for a Hypixel Guild.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "dev": "node --enable-source-maps --env-file=.env ./dist/index.js",
    "deploy-cmd": "node --env-file=.env ./dist/deploy-commands.js",
    "deploy-db": "drizzle-kit push",
    "create-guild": "node --env-file=.env ./dist/scripts/create-guild.js",
    "reset-db": "node --env-file=.env ./dist/scripts/reset-db.js",
    "seed": "node --env-file=.env ./dist/scripts/seed.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "CC0",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "canvas": "^3.2.3",
    "d3": "^7.9.0",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.3",
    "jsdom": "^30.1.1",
    "lzma-native": "^8.0.6",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/lzma-native": "^4.0.4",
    "@types/node": "^26.6.3",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "lzma-native@8.0.6": true,
    "esbuild@0.27.2": true
  },
  "overrides": {
    "esbuild": "^0.27.2"
  }
}